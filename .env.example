# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Node does not read .env on its own: use `node --env-file=.env ...`,
# `docker run --env-file .env ...`, or your process manager.

# Interface to bind. Keep 127.0.0.1 unless a reverse proxy or container
# network sits in front. The Docker image sets 0.0.0.0.
HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp

# JSON file of hashed tokens, managed with `npm run tokens`.
TOKENS_FILE=./data/tokens.json

# Per-token token bucket: burst size and sustained requests per second.
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1
RATE_LIMIT_DISABLED=false

# Comma-separated browser origins allowed to call the endpoint. Leave empty
# unless a browser-based client needs access.
ALLOWED_ORIGINS=

MAX_BODY_BYTES=1048576
LOG_LEVEL=info

# Scopes granted to the local user in --stdio mode (no token on stdio).
STDIO_SCOPES=read,write
